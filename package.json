{
  "name": "virtual-life-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "node tools/build-wasm.mjs",
    "predev": "pnpm wasm",
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "pnpm wasm && pnpm check && vite build",
    "build:test": "node tools/build-test-site.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:web": "playwright test",
    "test:core": "cargo test --locked --workspace --all-targets",
    "test:lives": "node tools/run-life-probes.mjs",
    "test:fixtures": "pnpm test:lives && cargo run --locked --release -p virtual-life-core --features test-support --example export_web_scenarios",
    "test:ci": "node --test tools/verify-browser-coverage.test.mjs",
    "test:platform": "node --test --test-isolation=none crates/virtual-life-web/src/platform.test.mjs tools/display.test.mjs",
    "deps:snapshot": "node tools/dependency-snapshot.mjs",
    "test:formats": "node --test tools/legacy-formats.test.mjs tools/verify-assets.test.mjs",
    "verify:assets": "node tools/verify-assets.mjs",
    "verify:dependencies": "node tools/verify-dependency-freeze.mjs",
    "verify:dist": "node tools/verify-assets.mjs --dist"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": { "node": ">=26.13.0 <27" }
}
