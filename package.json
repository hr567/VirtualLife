{
  "name": "virtual-life-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "node tools/build-wasm.mjs",
    "predev": "pnpm wasm",
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "pnpm wasm && pnpm check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:web": "playwright test",
    "test:formats": "node --test tools/legacy-formats.test.mjs tools/verify-assets.test.mjs",
    "verify:assets": "node tools/verify-assets.mjs",
    "verify:dist": "node tools/verify-assets.mjs --dist"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@webgpu/types": "^0.1.65",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "packageManager": "pnpm@12.14.0"
}
