newharvest/c_w11sp1.flc","x":120,"y":62}],[{"frame":0,"frameCount":24,"initialFrame":true,"interval":35,"lastTick":0,"resource":"install/newharvest/c_m04wr.flc","x":120,"y":62},{"frame":0,"frameCount":10,"initialFrame":true,"interval":35,"lastTick":0,"resource":"install/newharvest/c_m04wra.flc","x":120,"y":62},{"frame":0,"frameCount":24,"initialFrame":true,"interval":35,"lastTick":0,"resource":"install/newharvest/c_m04wr1.flc","x":120,"y":62}],[{"frame":0,"frameCount":24,"initialFrame":true,"interval":35,"lastTick":0,"resource":"install/newharvest/c_m26no.flc","x":120,"y":62},{"frame":0,"frameCount":10,"initialFrame":true,"interval":35,"lastTick":0,"resource":"install/newharvest/c_m26noa.flc","x":120,"y":62},{"frame":0,"frameCount":24,"initialFrame":true,"interval":35,"lastTick":0,"resource":"install/newharvest/c_m26no1.flc","x":120,"y":62}],[{"frame":0,"frameCount":24,"initialFrame":true,"interval":35,"lastTick":0,"resource":"install/newharvest/c_w19rp.flc","x":120,"y":62},{"frame":0,"frameCount":10,"initialFrame":true,"interval":35,"lastTick":0,"resource":"install/newharvest/c_w19rpa.flc","x":120,"y":62},{"frame":0,"frameCount":24,"initialFrame":true,"interval":35,"lastTick":0,"resource":"install/newharvest/c_w19rp1.flc","x":120,"y":62}]]],"beautyIntro":[["欢迎参加【造型大赛】，所有的模特儿将公平的比赛一场，看看谁是本城最具有男性风采的模特儿。下面依次介绍选手。","第一位是来自本城的","先生，他虽然还不太出名，但已是时装杂志封面常客。身高1.86米，体重88公斤，最喜欢的事情是夏天去海边冲浪。","第二位是连续几年参赛的徐天汉先生，徐先生非常自信，他说他就是冲着冠军来的，徐先生身高1.83米，体重73公斤，最喜欢的事情是在上健身房练肌肉。","第三位是著名的电视模特儿洪天超先生，洪先生刚刚在纽约新夏季服装展上得到了最佳休闲形象奖，实力可畏。洪先生身高1.88米，体重78公斤，最喜欢的事情是去ＰＵＢ跳舞。","今晚第四位嘉宾是江文安先生，江先生是本年度东京模特儿大赛的最佳晚礼服奖得主，声望如日中天，是最具冠军相的竞争者。江先生身高1.84米，体重73公斤，最喜欢的事情是学习剑道。","接下来这些造型先生就将开始进行激烈的角逐，公正的评审将根据各人的表现给他们评分，今晚将决定谁有最佳的个人形象，并且还能得到丰厚的奖金。"],["欢迎参加【造型大赛】，在这里所有才貌出众的模特儿将公平的比赛一场，看看谁是本城最出色的模特儿。下面依次介绍选手。","第一位是来自本城的","小姐，身高1.76米，体重48公斤，最喜欢的事情是在夏天去海边冲浪。","第二位是连续几年参赛的徐紫臻小姐，徐小姐很有自信，她说她就是冲着冠军来的，徐小姐身高1.73米，体重43公斤，最喜欢的事情是在海滩上进行日光浴。","第三位是著名的电视模特儿杨佳玟小姐，杨小姐刚刚在纽约新夏季服装展上得到了最佳泳装形象奖，实力可畏。杨小姐身高1.78米，体重48公斤，最喜欢的事情是在纽约第五街购物。","今晚第四位嘉宾是江冰馨小姐，江小姐是本年度东京模特儿大赛的最佳晚礼服奖得主，是最具冠军相的竞争者。江小姐身高1.74米，体重43公斤，最喜欢的事情是学习剑道。","接下来这些竞选佳丽即将开始进行激烈的角逐，评审将根据各人的表现给她们评分，今晚将决定谁是个中翘楚，并且得到丰厚的奖金。"]],"beautyOpponents":[["徐天汉","洪天超","江文安"],["徐紫臻","杨佳玟","江冰馨"]],"beautyPodium":{"frame":0,"frameCount":12,"initialFrame":true,"interval":71,"lastTick":0,"resource":"install/harvest/bg01a1.flc","x":138,"y":74},"beautyStage":{"frame":0,"frameCount":50,"initialFrame":true,"interval":71,"lastTick":0,"resource":"install/newharvest/pm0rs01.flc","x":120,"y":62},"beautyText":["比赛开始，听，观众在欢呼，不愧是新天王级人物。喔！本次比赛一开始就有这么强的选手，下面的选手可得小心罗！","下面请第二位选手表演。哇！好漂亮的模特儿啊！请注意这个转身动作，犹如跳舞一般，一看就知道是多次参赛的老手。整个表演真令人赏心悦目，让我们看看评分状况。","超级偶像的外表，动作明星的身材，这位选手的表现也是很好，到底最后谁会取胜。啊呀，这个结尾动作稍显迟钝，不知会引起什么样的后果。","这就是今晚的第四位选手，看！新偶像出场了，形象闪亮，魅力四射，这位选手的形象令大家目瞪口呆，真不愧是顶尖名模！","现在由本城最公正的评委为选手打分，如果他们打分不正确，观众们可以吹口哨，起哄，扔鸡蛋！喔，分数出来了，让我们再次感谢参赛选手。","真是可惜啊！这帮评委都瞎了眼，我如此出众的形象只得了第四名，我恨啊！下次我一定要重新来过！","比赛结束了，今晚亮相的各位选手都以光彩夺目的形象深深打动了观众，但是只有这三位才能获得丰厚的奖金，他们是真正的明日之星。"],"beautyWalkStep":1.8,"charmThresholds":[[180,250,320],[350,420,500],[550,650,750]],"judges":{"frame":0,"frameCount":120,"initialFrame":true,"interval":17,"lastTick":0,"resource":"install/harvest/put2.flc","x":120,"y":62},"menu":[["欢迎参加「虚拟城大赛」，这里聚集了全城优秀的初中同学，表现优异的同学将获发奖学金。请你在下列三个参赛项目中选择一项参加。","可爱的同学们欢迎来参加「造型大赛」。尽情的把你最迷人的部份秀出来吧！如果你进入决赛那就等于打开成功之门，下期的时装杂志绝少不了你。","正值发育时期的你，应该有着发泄不完的精力吧！赶快加入「飞人大赛」，努力的向前冲吧！","各位同学们，现在是考验你们智力的时候了，请你用心作答，入围前三名，将会有意想不到的收获喔！"],["欢迎参加「虚拟城大赛」，这里聚集了全城优秀的高中同学，表现优异的同学将获发奖学金。请你在下列三个参赛项目中选择一项参加。","你崇拜的偶像是王力宏还是yuki呢？有机会的话你是否也想成为众人的偶像呢？别再等了，快来参加造型大赛吧！有朝一日在台上「妙～妙～妙～」的人可能就是你喔！","「飞人大赛」一触即发，这是展现你运动才能的最佳时机，在进行激烈的竞争后，将会产生出金、银、铜牌得主，你别错过蠃得大奖的机会啊！","你是否感叹上知天文、下知地理，却找不到对手呢？参加「智力大赛」是你展现实力的最佳机会喔！"],["你想要让你的未来不只是梦吗？赶快把握这次机会，欢迎再次参加「虚拟城大赛」，让你在大学生涯中留下一个美好的回忆，而且还有奖金等着你来拿喔！现在请你在三个比赛项目中任意选择一个参赛吧。","你想在合适的场合公开展示你的形象魅力吗？参加「造型大赛」吧！幸运的话，明日之星就是你喽！","【百米大赛】这个历久不衰的比赛项目，仍然吸引了最多的选手和观众，请别犹豫，立刻投入这火爆青春的飞人大赛！ ","大学阶段的学习主要是为了充分开发你的智力，参加「智力大赛」将能让你发挥满腹的才学。谁是学富五车、才高八斗的人中之龙？马上就要见分晓。"]],"moneyAnimation":{"frame":0,"frameCount":69,"initialFrame":true,"interval":71,"lastTick":0,"resource":"install/harvest/feng_mon.flc","x":136,"y":0},"openingAnimation":{"frame":0,"frameCount":43,"initialFrame":true,"interval":100,"lastTick":0,"resource":"install/harvest/feng_ani.flc","x":120,"y":62},"podiumPlaces":[{"frame":0,"frameCount":18,"initialFrame":true,"interval":114,"lastTick":0,"resource":"install/harvest/bg01b1.flc","x":202,"y":161},{"frame":0,"frameCount":18,"initialFrame":true,"interval":114,"lastTick":0,"resource":"install/harvest/bg01b2.flc","x":202,"y":210},{"frame":0,"frameCount":18,"initialFrame":true,"interval":114,"lastTick":0,"resource":"install/harvest/bg01b3.flc","x":202,"y":259}],"prizes":[850,3000,6000,10000],"quizFeedback":[{"frame":0,"frameCount":8,"initialFrame":true,"interval":142,"lastTick":0,"resource":"install/harvest/w01.flc","x":364,"y":217},{"frame":0,"frameCount":6,"initialFrame":true,"interval":142,"lastTick":0,"resource":"install/harvest/r01.flc","x":364,"y":217}],"quizText":["欢迎选择【智力大赛】，这里的一切都取决于你答题的正确率，请注意那个正确率显示器。所有选手都是智力超群，被称为世纪天才！你想从天才中脱颖而出吗？就请仔细答题吧。","好，比赛开始，下面的题目，也许你做不出，没关系，随便选个答案就可以，比运气嘛。一共十题，要好好表现哦！","哇！今天的题目好容易啊！巨额奖金想拒绝都不行啊！","嘿！好家伙，居然考不倒你！你真的是聪明绝顶吗？下面继续努力呀！","我没走眼吧，你就这么点水准！不过下面还有机会，仔细答题奖金还是你的。","哇靠！正确率还不低啊！就要向奖金冲刺了，全力加速啊。","你怎么了？比赛就快结束了，你的正确率还这么低，你不想去领奖吗？","本场大赛结束了，很遗憾你的本事不够，而别人早已不客气的拿走了奖金，唉  以你的智力真不够格参加这样的比赛，以后还是参加其他项目吧。","惊心动魄的智力大赛结束了！恭喜你获得了第三名，你真是太幸运了，快去领奖吧，第三名可以获得3000元。","祝贺你，你的智力不是盖的，这样难度的题目能有这样高的正确率，你的前途不可限量啊，第二名奖金，有6000元啊！","天才终于诞生了！你的智力已经无可限量了。我们全城居民对你钦佩极了，不过我们还是要把这10000元送给你。你以后一定会有一番大事业的。"],"rankAnimations":[{"frame":0,"frameCount":46,"initialFrame":true,"interval":71,"lastTick":0,"resource":"install/harvest/no_3.flc","x":183,"y":87},{"frame":0,"frameCount":46,"initialFrame":true,"interval":71,"lastTick":0,"resource":"install/harvest/no_2.flc","x":183,"y":87},{"frame":0,"frameCount":45,"initialFrame":true,"interval":71,"lastTick":0,"resource":"install/harvest/no_1.flc","x":183,"y":87}],"running":{"actors":[[[{"frame":0,"frameCount":25,"initialFrame":true,"interval":71,"lastTick":0,"resourc